{
  "name": "notch-pet",
  "productName": "Notch Pet",
  "version": "1.4.2",
  "description": "Una mascota en el borde de tu pantalla que vigila tus sesiones de Claude Code",
  "author": "Ruben",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node state.js && node hooks.js && node recover.js && node updater.js && node asks.js && node i18n.js && node test/locales.test.js && electron test/ui.test.js",
    "dist": "node icon.js && electron-builder --win nsis --publish never",
    "test:ui": "electron test/ui.test.js",
    "test:mouse": "node test/real-mouse.js 2"
  },
  "build": {
    "appId": "com.notchpet.app",
    "files": [
      "main.js",
      "preload.js",
      "state.js",
      "recover.js",
      "hooks.js",
      "hook.js",
      "icon.js",
      "fullscreen.js",
      "shared.js",
      "notch.js",
      "settings.js",
      "index.html",
      "settings.html",
      "pet.css",
      "notch.css",
      "settings.css",
      "updater.js",
      "asks.js",
      "i18n.js",
      "locales/*.json"
    ],
    "asarUnpack": [
      "hook.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Notch Pet",
      "runAfterFinish": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Notch Pet",
      "artifactName": "NotchPet-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RubenMRDev",
        "repo": "notch-pet",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
